# =====================================================
#  server/.env.example
#  Энэ файлыг .env нэрээр хуулж аваад утгуудаа бөглөнө:
#     cp .env.example .env
#
#  ⚠️ .env файлыг GitHub-д хэзээ ч бүү оруул.
#     .gitignore дотор аль хэдийн жагсаагдсан.
# =====================================================

# hosting: 'production' бол сервер илүү хатуу шалгана
NODE_ENV=development


# -----------------------------------------------------
#  Өгөгдлийн сан
# -----------------------------------------------------
DB_HOST=localhost
DB_PORT=3306

# Бодит орчинд root ХЭРЭГЛЭХГҮЙ.
# db/schema.sql-ийн төгсгөлд хязгаарлагдмал хэрэглэгч
# үүсгэх код байгаа — комментыг нь авч ажиллуулна.
# Хөгжүүлэлтэд root байж болно.
DB_USER=root

# Тусгай тэмдэгт (#, $, !) агуулсан бол заавал хашилтанд
DB_PASSWORD="ЭНД_ЖИНХЭНЭ_НУУЦ_ҮГ"

DB_NAME=internship_system


# -----------------------------------------------------
#  Аюулгүй байдал
# -----------------------------------------------------
# Дор хаяж 32 тэмдэгт. Үүсгэх:  npm run gen-secret
# Солиход нэвтэрсэн бүх хэрэглэгч гарна.
JWT_SECRET=

PORT=3000

# Сэргээх холбоос, чиглүүлэлтэд ашиглагдах үндсэн хаяг.
# Бодит орчинд заавал https:// -ээр эхэлнэ.
BASE_URL=http://localhost:3000

# Nginx зэрэг прокси ард ажиллаж байвал true
TRUST_PROXY=false

# HTTP хүсэлтийг HTTPS руу албадан шилжүүлэх.
# Бодит орчинд заавал true.
FORCE_HTTPS=false

# Гадаад домэйнээс API дуудахыг зөвшөөрөх (таслалаар тусгаарлана).
# Frontend-ийг ижил сервер түгээдэг тул ихэвчлэн хоосон.
CORS_ORIGINS=


# -----------------------------------------------------
#  Хөгжүүлэлт
# -----------------------------------------------------
# Нууц үг сэргээх холбоосыг дэлгэц дээр харуулна.
# Бодит орчинд true байвал сервер асахгүй.
SHOW_RESET_LINK=true


# =====================================================
#  БОДИТ ОРЧНЫ ЖИШЭЭ
# =====================================================
# NODE_ENV=production
# DB_USER=internship_app
# JWT_SECRET=<gen-secret үүсгэсэн урт мөр>
# BASE_URL=https://dadlaga.mn
# TRUST_PROXY=true
# FORCE_HTTPS=true
# SHOW_RESET_LINK=false